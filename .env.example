# Address of the Supabase project whose accounts sign in on /login.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The project's publishable key. Public by design; it only identifies the project.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Full Postgres connection string. Drizzle uses it for customers, profiles and entries. Secret: server only.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@your-pooler-host.pooler.supabase.com:6543/postgres
